{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hunt Card",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "revision",
    "hypothesis",
    "technique",
    "evidence",
    "variants",
    "status",
    "history",
    "scope"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "release_id": {
      "type": "string",
      "pattern": "^hf-\\d{8}-[0-9a-f]{12}$"
    },
    "id": {
      "type": "string",
      "pattern": "^(HF-(INT|IOC)-[A-F0-9]{14}|HF-\\d{4}-\\d{4})$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "technique": {
      "type": "string",
      "pattern": "^T\\d{4}(\\.\\d{3})?$"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source",
          "url",
          "source_id",
          "published",
          "location",
          "claim"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "published": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}"
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "observation_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "modified": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "status": {
      "enum": [
        "validated",
        "partially_validated"
      ]
    },
    "history": {
      "type": "array",
      "minItems": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "variants": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "table",
          "profile_revision",
          "validation",
          "queries"
        ],
        "properties": {
          "table": {
            "type": "string",
            "minLength": 1
          },
          "profile_revision": {
            "type": "integer",
            "minimum": 1
          },
          "validation": {
            "type": "object",
            "required": [
              "evidence",
              "syntax",
              "schema",
              "static",
              "synthetic_fixture",
              "engine",
              "workspace",
              "analyst"
            ],
            "properties": {
              "evidence": {
                "enum": [
                  "pass",
                  "fail",
                  "not_run",
                  "not_applicable"
                ]
              },
              "syntax": {
                "enum": [
                  "pass",
                  "fail",
                  "not_run",
                  "not_applicable"
                ]
              },
              "schema": {
                "enum": [
                  "pass",
                  "fail",
                  "not_run",
                  "not_applicable"
                ]
              },
              "static": {
                "enum": [
                  "pass",
                  "fail",
                  "not_run",
                  "not_applicable"
                ]
              },
              "synthetic_fixture": {
                "enum": [
                  "pass",
                  "fail",
                  "not_run",
                  "not_applicable"
                ]
              },
              "engine": {
                "enum": [
                  "pass",
                  "fail",
                  "not_run",
                  "not_applicable"
                ]
              },
              "workspace": {
                "enum": [
                  "pass",
                  "fail",
                  "not_run",
                  "not_applicable"
                ]
              },
              "analyst": {
                "enum": [
                  "pass",
                  "fail",
                  "not_run",
                  "not_applicable"
                ]
              }
            },
            "additionalProperties": false
          },
          "queries": {
            "type": "object",
            "required": [
              "1",
              "3",
              "7",
              "14",
              "30"
            ],
            "additionalProperties": {
              "type": "object",
              "required": [
                "table",
                "json"
              ],
              "properties": {
                "table": {
                  "type": "string",
                  "minLength": 1
                },
                "json": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  }
}
