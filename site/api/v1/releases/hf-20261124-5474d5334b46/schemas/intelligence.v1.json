{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public intelligence record",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "summary",
    "source",
    "evidence",
    "published",
    "revision",
    "severity",
    "confidence",
    "tags",
    "cves"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "release_id": {
      "type": "string",
      "pattern": "^hf-\\d{8}-[0-9a-f]{12}$"
    },
    "id": {
      "type": "string",
      "pattern": "^(HF-(INT|IOC)-[A-F0-9]{14}|HF-\\d{4}-\\d{4})$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source",
          "url",
          "source_id",
          "published",
          "location",
          "claim"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "published": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}"
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "observation_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "modified": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "published": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "severity": {
      "enum": [
        "high",
        "medium",
        "low",
        "unrated"
      ]
    },
    "confidence": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cves": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CVE-\\d{4}-\\d{4,}$"
      }
    },
    "in_window": {
      "type": "boolean"
    },
    "retrieved": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
