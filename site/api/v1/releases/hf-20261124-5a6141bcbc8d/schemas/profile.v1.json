{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Environment profile",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "revision",
    "target",
    "source",
    "assumptions",
    "synthetic",
    "tables"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "release_id": {
      "type": "string",
      "pattern": "^hf-\\d{8}-[0-9a-f]{12}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z]+(-[a-z]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "tables": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "timestamp",
          "columns",
          "mappings",
          "capability"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "columns": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "enum": [
                "datetime",
                "string",
                "int",
                "long",
                "bool",
                "dynamic",
                "real"
              ]
            }
          },
          "mappings": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
