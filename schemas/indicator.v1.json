{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Indicator",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "type",
    "value",
    "original",
    "display",
    "evidence",
    "reported",
    "aging_review",
    "revision"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "release_id": {
      "type": "string",
      "pattern": "^hf-\\d{8}-[0-9a-f]{12}$"
    },
    "id": {
      "type": "string",
      "pattern": "^(HF-(INT|IOC)-[A-F0-9]{14}|HF-\\d{4}-\\d{4})$"
    },
    "type": {
      "enum": [
        "ipv4",
        "domain",
        "url"
      ]
    },
    "value": {
      "type": "string",
      "minLength": 1
    },
    "original": {
      "type": "string",
      "minLength": 1
    },
    "display": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source",
          "url",
          "source_id",
          "published",
          "location",
          "claim"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "published": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}"
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "observation_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "modified": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "reported": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "aging_review": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "first_observed": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_observed": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_expires": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "record_id": {
      "type": "string",
      "pattern": "^(HF-(INT|IOC)-[A-F0-9]{14}|HF-\\d{4}-\\d{4})$"
    }
  }
}
